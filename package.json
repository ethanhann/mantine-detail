{
	"name": "@ethanhann/mantine-detail",
	"version": "0.1.0",
	"description": "The single-record companion to @ethanhann/mantine-dataview: a record's view/edit/create lifecycle in a pluggable surface, reconciled back into a master list. Built on Mantine v9.",
	"type": "module",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./styles.css": "./dist/mantine-detail.css",
		"./dataview": {
			"types": "./dist/dataview/index.d.ts",
			"import": "./dist/dataview/index.js"
		},
		"./mantine-form": {
			"types": "./dist/mantine-form/index.d.ts",
			"import": "./dist/mantine-form/index.js"
		},
		"./react-hook-form": {
			"types": "./dist/react-hook-form/index.d.ts",
			"import": "./dist/react-hook-form/index.js"
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"dev": "storybook dev -p 6006",
		"build": "vite build",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write .",
		"storybook:build": "storybook build",
		"prepublishOnly": "npm run build"
	},
	"engines": {
		"node": ">=18"
	},
	"peerDependencies": {
		"@ethanhann/mantine-dataview": ">=0.8.0",
		"@mantine/core": "^9.0.0",
		"@mantine/form": "^9.0.0",
		"@mantine/hooks": "^9.0.0",
		"@mantine/modals": "^9.0.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-hook-form": "^7.0.0"
	},
	"peerDependenciesMeta": {
		"@ethanhann/mantine-dataview": {
			"optional": true
		},
		"@mantine/form": {
			"optional": true
		},
		"react-hook-form": {
			"optional": true
		}
	},
	"devDependencies": {
		"@axe-core/react": "^4.11.1",
		"@biomejs/biome": "2.4.16",
		"@ethanhann/mantine-dataview": "^0.8.0",
		"@mantine/core": "^9.3.0",
		"@mantine/dates": "^9.3.0",
		"@mantine/form": "^9.3.0",
		"@mantine/hooks": "^9.3.0",
		"@mantine/modals": "^9.3.0",
		"@storybook/addon-a11y": "^10.3.4",
		"@storybook/react": "^10.3.4",
		"@storybook/react-vite": "^10.3.4",
		"@tabler/icons-react": "^3.41.1",
		"@tanstack/react-table": "^8.21.3",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/bun": "^1.3.11",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitest/coverage-v8": "^4.1.2",
		"dayjs": "^1.11.21",
		"jsdom": "^29.0.1",
		"postcss": "^8.5.8",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-hook-form": "^7.54.0",
		"storybook": "^10.3.4",
		"typescript": "^6.0.2",
		"unplugin-dts": "^1.0.2",
		"vite": "^8.0.3",
		"vitest": "^4.1.2",
		"vitest-axe": "^0.1.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ethanhann/mantine-detail-prototype.git"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org"
	},
	"license": "MIT"
}
